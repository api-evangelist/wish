          "id": "87e940f6-d3f4-467d-be60-673c6635940d",
          "name": "Retrieve an access token",
          "request": {
            "name": "Retrieve an access token",
            "description": {
              "content": "An access token and a refresh token will be returned through this API. Your application should store both tokens. The access token is used to make authorized requests and the refresh token is used to obtain new access tokens. For security reasons, the access token will expire after 30 days. When the access token expires, please use refresh_token API to get new ones.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "oauth",
                "access_token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
