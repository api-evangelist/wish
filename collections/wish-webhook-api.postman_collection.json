  "item": [
    {
      "id": "4d2c4e18-cc33-4b5b-9688-36551a4ccf78",
      "name": "Webhook",
      "description": {
        "content": "APIs for managing webhook subscriptions. Merchants can use webhook subscriptions to receive notifications about particular events, instead of having to make API calls periodically to check their status. Note that these APIs are for merchants, not ERPs. For ERPs, please log into merchant dashboard to update your ERP-level webhook subscription. Visit the [webhook documentation](https://merchant.wish.com/documentation/webhooks) to learn more.",
        "type": "text/plain"
      },
      "item": [
        {
