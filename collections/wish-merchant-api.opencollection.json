{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wish Marketplace V3 Brands Merchant API",
    "version": "3.0.65"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://merchant.wish.com/v3/oauth/authorize",
      "accessTokenUrl": "https://merchant.wish.com/api/v3/oauth/access_token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Merchant",
        "type": "folder"
      },
      "items": [
